@section Styles
{
    <link rel="stylesheet" href="~/admin/vendors/datatables.net-bs4/dataTables.bootstrap4.css">
    <link rel="stylesheet" href="~/Admin/vendors/font-awesome/css/font-awesome.min.css">

}

<div class="content-wrapper">
    <div class="page-header">
        <h3 class="page-title"> @Labels.Shipments </h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">@Labels.Shipments</a></li>
                <li class="breadcrumb-item active" aria-current="page">Shipments table</li>
            </ol>
        </nav>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    <div class="card">
        <div class="card-body">
            <h4 class="card-title"></h4>
            <div class="row">
                <div class="col-12">
                </div>
                <div class="col-12">

                    <div class="table-responsive">
                        <table id="shipments-table" class="table" data-controller="@ViewContext.RouteData.Values["controller"]">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Tracking Number</th>
                                    <th>Order Date</th>
                                    <th>Shipping Value</th>
                                    <th>Sender Name</th>
                                    <th>Receiver Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="shipments-table-body">
                                <!-- Data will be injected here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="pagination" class="mt-3 text-center"></div>
            </div>
        </div>
    </div>


</div>
@section Scripts
{
    <!-- plugins:js -->
    <script src="~/Admin/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="~/Admin/vendors/datatables.net/jquery.dataTables.js"></script>
    <script src="~/Admin/vendors/datatables.net-bs4/dataTables.bootstrap4.js"></script>
    <!-- End plugin js for this page -->
    <!-- Custom js for this page -->
    <script src="~/Admin/js/data-table.js"></script>
    <!-- End custom js for this page -->

     <script src="~/modules/apphelper.js"></script>
    <script src="~/modules/apiclient.js"></script>
    <script src="~/modules/shipment/shipmentsservice.js"></script>
    <script src="~/modules/shipment/list.js"></script>


    @if (TempData["MessageType"] != null)
    {
        <script>
            $(document).ready(function () {
                let messageType = @TempData["MessageType"]
                console.log(messageType);
                switch (messageType) {
                    case 1:
                        alert.Success('@Messages.SaveSuccessTitle', '@Messages.SaveSuccessMessage');
                        break;
                    case 2:
                        alert.Error('@Messages.SaveFailedTitle', '@Messages.SaveFailedMessage');
                        break;
                    case 3:
                        alert.Success('@Messages.DeleteSuccessTitle', '@Messages.DeleteSucessMessage');
                        break;
                    case 4:
                        alert.Error('@Messages.DeleteFailedTitle', '@Messages.DeleteFailedMessage');
                        break;
                    default:
                        console.log("Unknown message type");
                        break;
                }
            });
        </script>
    }

}
<!-- content-wrapper ends -->
